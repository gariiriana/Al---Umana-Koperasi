// Firestore security rules for Al-Umana Order Fulfillment & Delivery
// Tracking System and Customer Storefront / Admin Stock Management.
//
// Security model:
//   - Default DENY at the root.
//   - Every named collection grants only the operations needed for its
//     documented purpose, gated on either authentication or admin role.
//   - Wildcard write access is never permitted; rules are written with
//     explicit `request.auth != null` guards per Requirement 8.3 / 10.2
//     of the order-fulfillment spec and Requirement 16.x of the
//     customer-storefront-admin-stock spec.
//
// Collections:
//   orders             — order pipeline state
//   inventory          — product catalogue (public read; writes via backend)
//   courier_locations  — latest courier GPS positions
//     ./location_history — append-only history per courier
//   delivery_files     — chunked proof-of-delivery file metadata
//     ./chunks         — per-chunk Base64 payloads
//   carts              — per-customer shopping cart line items
//     {customerId}/items/{itemId}
//   payment_proofs     — chunked customer payment proof uploads
//     ./chunks         — per-chunk Base64 payloads
//   product_images     — chunked admin-uploaded product photos
//     ./chunks         — per-chunk Base64 payloads
//   users              — user profiles (role, saved address, ...)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    // Defined at the top of the documents match block so every rule below
    // can reference it. `isAdmin()` checks the `users/{uid}.role` field
    // in Firestore. Backend service-account writes bypass rules entirely.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTimProduksi() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tim_produksi'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'produksi_1'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'produksi_2'
        );
    }

    function isDistribusi() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi_1'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi_2'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distributor'
        );
    }

    // -------------------------------------------------------------------
    // MBG Role Helpers
    // -------------------------------------------------------------------
    function isAdminMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin_mbg';
    }

    function isProduksiMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'produksi_mbg';
    }

    function isPurchasingMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'purchasing_mbg';
    }

    function isDistribusiMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi_mbg'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi_mbg_2'
        );
    }

    function isKurirMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kurir_mbg'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kurir'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi_mbg'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'distribusi_mbg_2'
        );
    }

    function isSubPurchasingMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sub_purchasing_mbg';
    }

    function isDokumentasiProduksiMbg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dokumentasi_produksiMBG';
    }

    function isProduksiMbg2() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MBG2'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mbg2'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'produksi_mbg_2'
        );
    }

    function isAnyMbg() {
      return isAdminMbg() || isProduksiMbg() || isProduksiMbg2() || isDokumentasiProduksiMbg() || isPurchasingMbg() || isDistribusiMbg() || isKurirMbg() || isSubPurchasingMbg();
    }

    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Developer is a deliberately separate break-glass role. Its account is
    // provisioned manually in `users/{uid}` and may inspect/repair every
    // document, including data normally hidden from operational roles.
    function isDeveloper() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer';
    }

    function isMbgManager() { return isAdmin() || isSuperAdmin() || isAdminMbg() || isProduksiMbg() || isProduksiMbg2(); }
    function isMbgDeliveryTeam() { return isMbgManager() || isDistribusiMbg() || isKurirMbg(); }
    function isMbgStaff() { return isAdmin() || isDeveloper() || isSuperAdmin() || isAnyMbg() || isMoKatering() || isCoMoKatering(); }

    // -------------------------------------------------------------------
    // Katering & Operational Role Helpers
    // -------------------------------------------------------------------
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isMoKatering() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserRole() == 'mo_katering';
    }

    function isCoMoKatering() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserRole() == 'co_mo_katering';
    }

    function isKateringOperational() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserRole() in [
          'produksi_1', 'distribusi_1', 'produksi_2', 'distribusi_2',
          'tim_produksi', 'distribusi', 'MBG2', 'mbg2',
          'produksi_mbg_2', 'distribusi_mbg_2'
        ];
    }

    function isOrderStaff() {
      return isAdmin() || isSuperAdmin() || isTimProduksi() || isDistribusi() || isKurirMbg() || isMoKatering() || isCoMoKatering() || isAnyMbg();
    }
    function isOwnDeliveryFile(fileId) {
      return get(/databases/$(database)/documents/delivery_files/$(fileId)).data.uploadedBy == request.auth.uid;
    }
    function isOwnPaymentProof(fileId) {
      return get(/databases/$(database)/documents/payment_proofs/$(fileId)).data.uploadedBy == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // Default deny. Any path not matched explicitly is forbidden.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isDeveloper();
    }

    // A delete in the client app first writes an immutable source snapshot
    // here, then deletes the source in the same batch.  Only Developer can
    // see, restore, or permanently destroy archived records.
    match /developer_recycle_bin/{archiveId} {
      allow create: if request.auth != null
        && request.resource.data.deletedBy == request.auth.uid;
      allow read, update, delete: if isDeveloper();
    }

    // -------------------------------------------------------------------
    // Catering Job Desks
    // -------------------------------------------------------------------
    // MO creates/updates/deletes job desk assignments.
    // Operational roles can update their assigned job desks (status, reason).
    // CO_MO can update review status (approve/reject).
    // All authenticated katering roles can read.
    match /catering_jobdesks/{jobDeskId} {
      allow read: if isAdmin() || isSuperAdmin() || isMoKatering() || isCoMoKatering() || isKateringOperational();
      allow create: if isAdmin() || isSuperAdmin() || isMoKatering();
      allow update: if isAdmin() || isSuperAdmin() || isMoKatering()
        || (isKateringOperational() && resource.data.assignedRole == getUserRole()
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.reviewStatus == 'pending_review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'incompleteReason', 'completionNote', 'completionPhotoUrl', 'reviewStatus', 'submittedAt', 'submittedBy', 'updatedAt']))
        || (isCoMoKatering() && resource.data.reviewStatus == 'pending_review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus', 'reviewedBy', 'reviewedAt', 'rejectionRemark', 'status', 'submittedAt', 'submittedBy', 'updatedAt']));
      allow delete: if isAdmin() || isSuperAdmin() || isMoKatering();
    }

    // -------------------------------------------------------------------
    // Orders
    // -------------------------------------------------------------------
    // Authenticated users can read, create, and update orders.
    // Only admins can delete.
    match /orders/{orderId} {
      allow get, list: if isOrderStaff()
        || (request.auth != null && resource.data.customerId == request.auth.uid);
      // Allow list for authenticated users OR unauthenticated (public invoice page).
      // The invoiceToken acts as a secret URL — knowing it grants read access.
      // Note: request.query.filters is not a valid Firestore Rules API,
      // so we allow unauthenticated list on this collection safely because:
      // 1. The invoiceToken is a random UUID (unguessable)
      // 2. Listing without a filter still requires knowing document structure
      allow create: if isOrderStaff()
        || (request.auth != null && request.resource.data.customerId == request.auth.uid);
      allow update: if isOrderStaff()
        || (request.auth != null && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerName', 'recipientName', 'recipientPhone', 'recipientNotes', 'deliveryAddress', 'paymentProofId', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow update: if isAdmin() || isTimProduksi();
      allow create, delete: if isAdmin() || isTimProduksi();
    }

    match /food_schedules/{date} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTimProduksi();
    }

    // -------------------------------------------------------------------
    // Courier locations
    // -------------------------------------------------------------------
    // Couriers write their own latest position to a doc keyed by
    // {orderId}_{courierId}. Admins (any authenticated user) can read all
    // positions for the live dashboard.
    //
    // The `courierId` field on the document MUST equal request.auth.uid;
    // this prevents one courier from spoofing another's position.
    match /courier_locations/{docId} {
      allow read: if isOrderStaff();
      allow create, update: if request.auth != null
        && isKurirMbg()
        && request.resource.data.courierId == request.auth.uid;
      allow delete: if false;

      match /location_history/{historyId} {
        allow read: if isOrderStaff();
        allow create: if request.auth != null
          && isKurirMbg()
          && request.resource.data.courierId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // Delivery files (proof-of-delivery, chunked storage)
    // -------------------------------------------------------------------
    // Authenticated users may read/write parent metadata and per-chunk
    // documents. The Go backend is the canonical reader (assembly +
    // download); clients write here as part of the chunk upload flow.
    //
    // The status field is constrained to the three protocol values to
    // prevent arbitrary writes.
    match /delivery_files/{fileId} {
      allow read: if request.auth != null && (isOrderStaff() || resource.data.uploadedBy == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status in ["uploading", "completed", "failed"];
      allow update: if request.auth != null
        && resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status in ["uploading", "completed", "failed"];
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if request.auth != null && (isOrderStaff() || isOwnDeliveryFile(fileId));
        allow create, update: if request.auth != null && isOwnDeliveryFile(fileId);
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // Carts (server-side shopping cart, per customer)
    // -------------------------------------------------------------------
    // Each customer owns the documents under `carts/{customerId}/items/*`.
    // Read and write are restricted to the customer themselves so cart
    // contents are private and cannot be tampered with by other users.
    // (Requirement 3.1, 3.2, 16.1).
    match /carts/{customerId}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == customerId;
      allow write: if request.auth != null && request.auth.uid == customerId;
    }

    // -------------------------------------------------------------------
    // Payment proofs (customer-uploaded, chunked storage)
    // -------------------------------------------------------------------
    // Customers upload proof-of-payment images for non-COD orders. Any
    // authenticated user may read parent metadata and chunks because the
    // admin role check for approval/rejection happens at the backend
    // (Requirement 8.x). Only the original uploader may create or update
    // their own proof document; status values are constrained to the
    // protocol set. Deletes are backend-only via the service account
    // (Requirement 7.7, 11.5).
    match /payment_proofs/{fileId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.uploadedBy == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status in ["uploading", "completed", "failed"];
      allow update: if request.auth != null
        && resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status in ["uploading", "completed", "failed"];
      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if request.auth != null && (isAdmin() || isOwnPaymentProof(fileId));
        allow create, update: if request.auth != null && isOwnPaymentProof(fileId);
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // Product images (admin-uploaded, chunked storage)
    // -------------------------------------------------------------------
    // Product images are part of the public catalog so unauthenticated
    // customers can render them while browsing (Requirement 1.7 / 16.2).
    // Writes are admin-only (Requirement 11.5, 16.3); the backend
    // service account bypasses rules for cascade deletes.
    match /product_images/{fileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isTimProduksi();

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || isTimProduksi();
      }
    }

    // -------------------------------------------------------------------
    // Users Profile Collection
    // -------------------------------------------------------------------
    // Rules for profile syncing, registration, and role escalation prevention.
    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isOrderStaff() || isSuperAdmin());
      allow list: if isOrderStaff() || isSuperAdmin();

      // Allow users to register/setup their own profile on first login/registration
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'pelanggan'
        && request.resource.data.email == request.auth.token.email;

      // Allow users to edit their own profile, but do not allow them to escalate/modify their own role
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber', 'savedDeliveryAddress', 'updatedAt']);

      // Role is an authority boundary. Only Super Admin may change it.
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /role_assignments/{assignmentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /performance_activities/{activityId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isSuperAdmin());
      // KPI records are append-only and must be tied to an approved Job Desk
      // or an approved additional task. This prevents browser-side XP forging.
      allow create: if request.resource.data.status == 'approved'
        && ((isCoMoKatering() || isSuperAdmin())
          && request.resource.data.sourceType == 'catering_jobdesk'
          && get(/databases/$(database)/documents/catering_jobdesks/$(request.resource.data.sourceId)).data.reviewStatus == 'approved'
          && get(/databases/$(database)/documents/catering_jobdesks/$(request.resource.data.sourceId)).data.submittedBy == request.resource.data.userId
          || (isSuperAdmin()
            && request.resource.data.sourceType == 'ad_hoc_task'
            && getAfter(/databases/$(database)/documents/ad_hoc_tasks/$(request.resource.data.sourceId)).data.status == 'approved'
            && getAfter(/databases/$(database)/documents/ad_hoc_tasks/$(request.resource.data.sourceId)).data.assigneeId == request.resource.data.userId));
      allow update: if false;
      allow delete: if false;
    }

    match /ad_hoc_tasks/{taskId} {
      allow read: if request.auth != null && (resource.data.assigneeId == request.auth.uid || isSuperAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (request.auth != null && resource.data.assigneeId == request.auth.uid
          && resource.data.status in ['pending', 'in_progress', 'revision_required']
          && request.resource.data.status == 'pending_review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'evidenceNote', 'submittedAt', 'updatedAt']));
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // Notifications (real-time push notifications per user)
    // -------------------------------------------------------------------
    // Recipients can only read their own notifications.
    // Any authenticated user (admin, kurir, tim_produksi) can create
    // notifications for customers.
    // Recipients can update their own notifications (mark as read).
    // Only admins can delete.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (resource.data.recipientId == request.auth.uid || isOrderStaff());
      allow create: if isOrderStaff();
      allow update: if request.auth != null && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Promos & Discounts
    // -------------------------------------------------------------------
    // Public get allows checkout to validate promo codes without auth.
    // Only admins can list all, create, update, or delete promos.
    match /promos/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Distribution Schedules
    // -------------------------------------------------------------------
    // Admin, tim_produksi, and distribusi can manage distribution schedules.
    match /distribution_schedules/{scheduleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTimProduksi() || isDistribusi();
    }

    // -------------------------------------------------------------------
    // Reviews / Testimonials
    // -------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // MBG PM Batches (batch pengiriman per tanggal)
    // -------------------------------------------------------------------
    match /mbg_pm_batches/{batchId} {
      allow read: if isMbgStaff();
      allow create, delete: if isMbgManager();
      allow update: if isMbgManager()
        // Distribusi may materialize PM rows from an existing Excel daily
        // report. It may only recalculate the aggregate fields and advance a
        // new draft to PM_SUBMITTED; all other batch fields stay manager-only.
        || (isDistribusiMbg()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'totalSiswaBalita', 'totalBumilBusui', 'totalGuruKader',
            'totalPobiaNasi', 'totalJumlah', 'totalInstitusi', 'petugasList',
            'status', 'updatedAt'
          ])
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'DRAFT' && request.resource.data.status == 'PM_SUBMITTED')
          ))
        || ((isProduksiMbg() || isProduksiMbg2() || isDokumentasiProduksiMbg())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['productionCookingStatus', 'productionCookingUpdatedBy', 'productionCookingUpdatedAt', 'updatedAt'])
          && request.resource.data.productionCookingUpdatedBy == request.auth.uid
          && request.resource.data.productionCookingStatus in ['cooking', 'cooked']
          && (request.resource.data.productionCookingStatus == 'cooking' || resource.data.productionCookingStatus == 'cooking'))
        || (isKurirMbg() && request.resource.data.status == 'DELIVERED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.productionCookingStatus == 'cooked');
    }

    // -------------------------------------------------------------------
    // MBG PM Entries (data per institusi dalam batch)
    // -------------------------------------------------------------------
    match /mbg_pm_entries/{entryId} {
      allow read: if isMbgStaff();
      // Distribusi creates entries only through the Excel-to-distribution
      // synchronization flow; it still cannot delete PM entries.
      allow create: if isMbgManager() || isDistribusiMbg();
      allow delete: if isMbgManager();
      allow update: if isMbgManager() || isDistribusiMbg()
        || (isKurirMbg()
          && (resource.data.assignedPetugasId == request.auth.uid || resource.data.assignedKenekId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'photoMenuUrl', 'photoMenuDesc', 'photoPenerimaUrl', 'photoPenerimaDesc', 'photoPenerimaTimestamp', 'photoPenerimaLocation',
            'photoSerahTerimaUrl', 'photoSerahTerimaDesc', 'photoSerahTerimaTimestamp', 'photoSerahTerimaLocation',
            'photoSuratJalanUrl', 'photoSuratJalanDesc', 'updatedAt'
          ]));
    }

    // -------------------------------------------------------------------
    // MBG Settings & Weekly Schedules (Master Jadwal Menu Mingguan, dll)
    // -------------------------------------------------------------------
    match /mbg_settings/{settingId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager();
    }

    match /mbg_weekly_schedules/{scheduleId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager();
    }

    // -------------------------------------------------------------------
    // MBG Nutrition (kadar gizi per menu item)
    // -------------------------------------------------------------------
    match /mbg_nutrition/{nutritionId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager();
    }

    // -------------------------------------------------------------------
    // MBG Daily Reports (Laporan Harian Operasional PDF/Excel)
    // -------------------------------------------------------------------
    match /mbg_daily_reports/{reportId} {
      allow read: if isMbgStaff();
      allow write: if isMbgManager() || isDistribusiMbg();
    }

    // -------------------------------------------------------------------
    // MBG Custom TKPI (custom ingredients added by production)
    // -------------------------------------------------------------------
    match /mbg_custom_tkpi/{itemId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager();
    }

    // -------------------------------------------------------------------
    // MBG Suppliers (master data supplier)
    // -------------------------------------------------------------------
    match /mbg_suppliers/{supplierId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isAdmin() || isAdminMbg() || isPurchasingMbg() || isSubPurchasingMbg();
    }

    // -------------------------------------------------------------------
    // MBG Purchase Orders (belanja per supplier)
    // -------------------------------------------------------------------
    match /mbg_purchase_orders/{orderId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isAdmin() || isAdminMbg() || isPurchasingMbg() || isSubPurchasingMbg();
    }

    // -------------------------------------------------------------------
    // MBG Sub Purchasing Tasks (tugas belanja pasar / sub-purchasing)
    // -------------------------------------------------------------------
    match /mbg_sub_purchasing_tasks/{taskId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isAdmin() || isAdminMbg() || isPurchasingMbg() || isSubPurchasingMbg();
    }

    // -------------------------------------------------------------------
    // MBG QC Checks (quality control barang masuk)
    // -------------------------------------------------------------------
    match /mbg_qc_checks/{checkId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager() || isDistribusiMbg();
    }

    // -------------------------------------------------------------------
    // MBG Cooking Sessions (dokumentasi proses masak)
    // -------------------------------------------------------------------
    match /mbg_cooking_sessions/{sessionId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager() || isDokumentasiProduksiMbg();

      match /photos/{photoId} {
        allow read: if isMbgStaff();
        allow create, update, delete: if isMbgManager() || isDokumentasiProduksiMbg();
      }
    }

    // -------------------------------------------------------------------
    // MBG Delivery Tasks (tugas kurir per petugas)
    // -------------------------------------------------------------------
    match /mbg_delivery_tasks/{taskId} {
      allow read: if isMbgDeliveryTeam();
      allow create, delete: if isMbgManager() || isDistribusiMbg();
      allow update: if isMbgManager() || isDistribusiMbg()
        || (isKurirMbg() && (resource.data.petugasId == request.auth.uid || resource.data.kenekId == request.auth.uid)
          && (
            // Handover & delivery progress updates can be made by courier even before cooking finishes
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'handoverPhotoId', 'handoverAt', 'deliveryPhotos', 'schoolProofs', 'updatedAt'
            ]) && request.resource.data.status != 'delivered')
            ||
            // Final execution of report ('delivered' / completedAt) requires cooking to be finished
            (get(/databases/$(database)/documents/mbg_pm_batches/$(resource.data.batchId)).data.productionCookingStatus == 'cooked'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'handoverPhotoId', 'handoverAt', 'deliveryPhotos', 'schoolProofs', 'completedAt', 'updatedAt'
              ]))
          ));
    }

    // -------------------------------------------------------------------
    // MBG Custom Recipes (resep kustom buatan tim produksi)
    // -------------------------------------------------------------------
    match /mbg_custom_recipes/{recipeId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager();
    }

    // -------------------------------------------------------------------
    // MBG Recipe Adjustments (koreksi takaran bahan baku per batch)
    // -------------------------------------------------------------------
    match /mbg_recipe_adjustments/{adjustmentId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager();
    }

    // -------------------------------------------------------------------
    // MBG Delivery Documents (arsip dokumen PDF kurir)
    // -------------------------------------------------------------------
    match /mbg_delivery_documents/{docId} {
      allow read: if isMbgStaff();
      allow create: if isMbgDeliveryTeam() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isMbgManager() || isDistribusiMbg();
    }

    // -------------------------------------------------------------------
    // MBG Purchasing Documents (arsip dokumen PDF/Word purchasing)
    // -------------------------------------------------------------------
    match /mbg_purchasing_documents/{docId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isAdmin() || isAdminMbg() || isPurchasingMbg() || isSubPurchasingMbg();
    }

    // -------------------------------------------------------------------
    // MBG Bahan Documentation (arsip dokumentasi foto bahan distribusi)
    // -------------------------------------------------------------------
    match /mbg_bahan_documentation/{docId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager() || isDistribusiMbg() || isKurirMbg();
    }

    // -------------------------------------------------------------------
    // MBG Inspection Forms (form pemeriksaan / cek list bahan makanan)
    // -------------------------------------------------------------------
    match /mbg_inspection_forms/{formId} {
      allow read: if isMbgStaff();
      allow create, update, delete: if isMbgManager() || isDistribusiMbg() || isKurirMbg();
    }
  }
}

